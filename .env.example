# Configuration reference.
#
# The stack runs WITHOUT a .env file: docker-compose.yml carries every default,
# including the provider URL. Copy this file to .env only to override a value.
# .env is git-ignored; never commit secrets.
#
# Durations use Go syntax (100ms, 5s, 10m, 24h). Every duration is configurable
# so that tests can shorten it.
#
# The values are the defaults defined in docs/adr/. Where an ADR fixes a behaviour
# but not a number, the line is marked "(initial value; tuned in P6)": the value
# is used as it stands and is checked against the load and chaos results in P6.
# See D66 in the decision ledger. Alert thresholds are not configured here;
# they live in the Prometheus rule file (D74).

# ---------------------------------------------------------------- Provider
# The external notification provider. Default: a webhook.site URL configured to
# answer 202 with {"messageId","status","timestamp"}. Free URLs expire and have a
# request cap; see the README section "Creating a webhook.site URL".
# Requests sent to a webhook.site URL are publicly visible: use only reserved fake
# values (+905551234567, example.com addresses) in demo and test data.
# For anything beyond a few requests use the mock profile instead: make up-mock.
PROVIDER_URL=https://webhook.site/<your-uuid>
# Name of the header that carries the notification id on every attempt.
PROVIDER_IDEMPOTENCY_HEADER=Idempotency-Key
# Provider name recorded on attempts and used in circuit-breaker keys.
PROVIDER_NAME=primary
# TCP connect timeout for provider requests.
PROVIDER_CONNECT_TIMEOUT=2s
# Total timeout for one provider request.
PROVIDER_TIMEOUT=10s

# ---------------------------------------------------------------- Connections
# Local development defaults only; not secrets.
DATABASE_URL=postgres://notifications:notifications@postgres:5432/notifications?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
# Automatic connection recovery of the RabbitMQ client: the wait before each
# reconnection attempt and the number of attempts. 24 x 5s is a budget of about
# two minutes. When it is used up, the relay, the worker and the gateway exit
# with a non-zero code and the restart policy starts them again.
# The status-event publishers (api, relay, worker) use the interval too: they
# dial again at most once per interval, and never give up.
AMQP_RECOVERY_RETRY_INTERVAL=5s
AMQP_RECOVERY_MAX_RETRIES=24

# ---------------------------------------------------------------- Ports
# Public API port: REST, /healthz, /readyz, /docs, /openapi.yaml.
API_ADDR=:8080
# Admin port of every service: /metrics, /healthz, /readyz, /debug/pprof. Not published.
ADMIN_ADDR=:8081
# WebSocket gateway port.
GATEWAY_ADDR=:8082
# Listen address of the mock provider of the mock profile.
MOCKPROVIDER_ADDR=:8090
# Host ports of the API, the WebSocket gateway and the three user interfaces.
# Read by docker-compose.yml only, not by the services; the ports inside the
# containers do not change. Set one when its default is already taken on the
# machine, in .env or on the command line:
#   GRAFANA_PORT=3001 docker-compose up
API_PORT=8080
GATEWAY_PORT=8082
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
# Host port of the mock provider. Read by docker-compose.mock.yml only, not by
# the services. Set it when 8090 is taken.
MOCKPROVIDER_PORT=8090

# ---------------------------------------------------------------- API
# Request body limit on every endpoint, in bytes (5 MB).
MAX_BODY_BYTES=5242880
# Retention of Idempotency-Key records.
IDEMPOTENCY_KEY_TTL=24h
# Phone number check: "possible" (IsPossibleNumber) or "strict" (IsValidNumber).
PHONE_VALIDATION=possible
# How far in the past scheduled_at may be and still mean "now" (the
# notification is then due at once and stored with scheduled_at NULL).
SCHEDULE_PAST_TOLERANCE=30s
# How far ahead a notification may be scheduled (30 days).
SCHEDULE_MAX_HORIZON=720h
# Minimum distance of an explicit expires_at from the due time of a create
# (scheduled_at, or now) and from now for a redrive.
EXPIRES_AT_MIN_LEAD=30s
# Metrics summary: reporting window and cache lifetimes.
SUMMARY_WINDOW=5m
SUMMARY_CACHE_TTL=2s
SUMMARY_BACKLOG_CACHE_TTL=10s

# ---------------------------------------------------------------- Relay
# Interval of the publishing cycle; also the scheduling precision.
RELAY_TICK_INTERVAL=100ms
# Maximum rows published per lane per cycle.
RELAY_BATCH_SIZE=200
# How long to wait for publisher confirms before rolling back.
RELAY_CONFIRM_TIMEOUT=5s
# High-water marks. Counted per lane (channel x priority); configured per priority,
# and each value applies to every channel.
LANE_HWM_HIGH=500
LANE_HWM_NORMAL=1000
LANE_HWM_LOW=500
# Expiry pass: cadence and batch size.
EXPIRY_INTERVAL=1s
EXPIRY_BATCH_SIZE=1000
# Idempotency-key cleanup: how often expired keys are deleted (batches of 1,000).
IDEMPOTENCY_CLEANUP_INTERVAL=1m
# Lease sweeper: cadence and batch size.
LEASE_SWEEP_INTERVAL=5s
LEASE_SWEEP_BATCH_SIZE=500
# Reconciliation runs at most once per this window; a trigger inside it is deferred.
RECONCILE_MIN_INTERVAL=60s
# How often the backlog gauges are measured.
BACKLOG_GAUGE_INTERVAL=10s

# ---------------------------------------------------------------- Worker
# Channels this worker serves. Default: all three in one container. The override
# docker-compose.override.worker-per-channel.yml runs one worker per channel
# instead and sets this variable for each of them.
WORKER_CHANNELS=sms,email,push
# Number of worker replicas that serve the same channel; used only to split the
# rate in the Redis-down fallback. It stays 1 in the per-channel layout
# (docker-compose.override.worker-per-channel.yml): one worker per channel.
WORKER_REPLICAS=1
# Concurrent sends per channel per replica; prefetch equals this value.
WORKER_CONCURRENCY=25
# Lease on a claimed notification.
LEASE_DURATION=30s
# How long the final write is retried when Postgres is unavailable.
FINAL_WRITE_RETRY_WINDOW=60s
# Time allowed for in-flight sends on SIGTERM (stop_grace_period is 20s).
SHUTDOWN_DRAIN_TIMEOUT=15s
# x-consumer-timeout of the dispatch queues.
CONSUMER_TIMEOUT=24h
# A claim that fails with a database error is retried in place, holding its
# message and concurrency slot: the wait starts at the base and doubles up to
# the maximum. On shutdown the message is returned to the queue.
CLAIM_RETRY_BASE=100ms
CLAIM_RETRY_MAX=5s

# ---------------------------------------------------------------- Rate limit
# Pacing rate per channel. 97 keeps every one-second window at or below 100
# with a margin: at 98 the largest window was 99 in 18 quiet runs and 100 in one
# run on a busy machine (docs/load-test.md).
RATE_LIMIT_PER_SECOND=97
# A slot is reserved only if it starts within this horizon.
RATE_LIMIT_HORIZON=250ms
# Wait before asking again when no slot is available within the horizon.
RATE_LIMIT_RETRY_INTERVAL=50ms
# How late a send may start after its reserved slot. A claim that returns later
# than this gives the slot up and reserves a new one, so every send leaves at a
# slot reserved for it. At 97 msg/s the limit of 100 leaves about 30 ms of total
# lateness; the tolerance must stay well below that.
PACER_SLOT_TOLERANCE=5ms
# Redis-down fallback (D25). Each call to Redis is bounded by this timeout; a
# call that fails switches the worker to an in-process limiter at
# RATE_LIMIT_PER_SECOND / WORKER_REPLICAS (approximate: the replicas share no
# clock) and sets limiter_fallback_active. Sending does not stop.
RATE_LIMIT_REDIS_TIMEOUT=250ms
# While the fallback is active, Redis is asked again at most this often; the
# first answer ends the fallback.
RATE_LIMIT_FALLBACK_PROBE_INTERVAL=1s

# ---------------------------------------------------------------- Retry profiles
# Back-off base, cap, failure budget and default TTL, per priority.
RETRY_HIGH_BASE=1s
RETRY_HIGH_CAP=30s
RETRY_HIGH_MAX_FAILURES=5
TTL_HIGH=10m
RETRY_NORMAL_BASE=5s
RETRY_NORMAL_CAP=10m
RETRY_NORMAL_MAX_FAILURES=8
TTL_NORMAL=6h
RETRY_LOW_BASE=30s
RETRY_LOW_CAP=1h
RETRY_LOW_MAX_FAILURES=10
TTL_LOW=24h
# Smallest retry delay. Full jitter can produce a delay near zero; the floor
# protects a provider that has just failed.
RETRY_MIN_DELAY=1s
# Upper bound applied to a provider's Retry-After.
RETRY_AFTER_CAP=10m
# Delay for a 429 without a usable Retry-After; doubles on consecutive 429s up to the maximum.
THROTTLE_DEFAULT_DELAY=5s
THROTTLE_MAX_DELAY=2m

# ---------------------------------------------------------------- Circuit breaker
# Sliding window in which outcomes are counted.
BREAKER_WINDOW=30s
# Opens at this many requests in the window with at least this failure ratio...
BREAKER_MIN_REQUESTS=20
BREAKER_FAILURE_RATIO=0.5
# ...or after this many consecutive failures.
BREAKER_CONSECUTIVE_FAILURES=5
# Open duration: starts here and doubles on each failed probe up to the maximum.
BREAKER_OPEN_BASE=5s
BREAKER_OPEN_MAX=2m
# Open duration after a provider_fatal result (401, 403, 404, 410, 3xx).
BREAKER_FATAL_OPEN=1m

# ---------------------------------------------------------------- Status events and WebSocket
# In-memory buffer of each event publisher; events are dropped when it is full.
# (initial value; tuned in P6)
EVENT_BUFFER_SIZE=1024
# How long a role that stops gives its buffered events to reach the broker
# before it cuts the connection. With the worker's 15 s drain it stays under
# the 20 s stop grace period.
EVENT_FLUSH_TIMEOUT=2s
# Gateway event queue: x-max-length and x-message-ttl. (initial value; tuned in P6)
EVENT_QUEUE_MAX_LENGTH=10000
EVENT_QUEUE_MESSAGE_TTL=30s
# Allowed WebSocket origins, comma-separated patterns. Empty: same origin only.
WS_ORIGIN_PATTERNS=
# Messages buffered per connection before a slow client is disconnected.
# (initial value; tuned in P6)
WS_SEND_QUEUE_SIZE=256
# Subscriptions allowed per connection.
WS_MAX_SUBSCRIPTIONS=1000
# Ping interval. A client that has not answered a ping when the next one is
# due is disconnected.
WS_PING_INTERVAL=30s
# Bound of every write to a client, of handing over the whole snapshot of one
# subscribe request (a client that does not take it in time is disconnected),
# and of closing the connections at shutdown.
WS_WRITE_TIMEOUT=10s

# ---------------------------------------------------------------- Templates
# Maximum template body size in bytes (64 KB).
TEMPLATE_MAX_BODY_BYTES=65536
# Maximum rendered output in bytes (512 KB).
TEMPLATE_MAX_OUTPUT_BYTES=524288

# ---------------------------------------------------------------- Observability
# Log level: debug, info, warn, error.
LOG_LEVEL=info
# Time each dependency check of /readyz gets; a check that has not answered
# by then has failed. Below the 2 s the healthcheck subcommand waits.
READINESS_CHECK_TIMEOUT=1s
# OTLP endpoint; traces go directly to Jaeger.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# Sampling: 1.0 for the demo, about 0.01 during load tests.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# How long a stopping role waits for its buffered spans to be exported; an
# unreachable Jaeger cannot hold the stop longer.
TRACING_SHUTDOWN_TIMEOUT=2s
